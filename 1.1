#include <WiFi.h>
#include <WebServer.h>
#include <Preferences.h>

/* ---------- Objects ---------- */

WebServer server(80);
Preferences prefs;

/* ---------- Constants ---------- */

const char* AP_NAME = "Система управления";

/* ---------- Variables ---------- */

String apPassword = "";
bool rebootRequired = false;

/* ---------- HTML helpers ---------- */

String htmlHeader(const String& title) {
  return
    "<!DOCTYPE html><html><head><meta charset='utf-8'>"
    "<meta name='viewport' content='width=device-width, initial-scale=1'>"
    "<title>" + title + "</title>"
    "<style>"
    "body{margin:0;font-family:Arial;background:#f0f2f5;}"
    ".container{max-width:420px;margin:40px auto;background:#fff;"
    "padding:20px;border-radius:8px;box-shadow:0 0 10px rgba(0,0,0,0.1);}"
    "h1{text-align:center;font-size:22px;margin-bottom:15px;}"
    "p{text-align:center;font-size:16px;}"
    "input{width:100%;padding:10px;margin-top:10px;font-size:16px;}"
    "button{width:100%;padding:10px;margin-top:15px;font-size:16px;"
    "background:#2196F3;color:white;border:none;border-radius:4px;}"
    "a{display:block;text-align:center;margin-top:15px;"
    "color:#2196F3;text-decoration:none;}"
    ".error{color:red;text-align:center;}"
    ".ok{color:green;text-align:center;}"
    "</style></head><body>";
}

String htmlFooter() {
  return "</body></html>";
}

/* ---------- Pages ---------- */

void handleRoot() {
  String page = htmlHeader("Система");
  page += "<div class='container'>";
  page += "<h1>Система управления</h1>";
  page += "<p>Система работает.<br>Данные датчиков будут здесь.</p>";
  page += "<a href='/config'>Настройки Wi-Fi</a>";
  page += "</div>";
  page += htmlFooter();

  server.send(200, "text/html", page);
}

void handleConfig() {
  String page = htmlHeader("Настройки");
  page += "<div class='container'>";
  page += "<h1>Пароль точки доступа</h1>";

  if (apPassword.length() >= 4) {
    page += "<p>Пароль уже установлен.</p>";
  } else {
    page += "<p>Пароль не установлен.</p>";
  }

  page +=
    "<form method='POST' action='/save'>"
    "<input type='password' name='p1' placeholder='Новый пароль (от 4 символов)' required>"
    "<input type='password' name='p2' placeholder='Повторите пароль' required>"
    "<button type='submit'>Сохранить</button>"
    "</form>";

  page += "<a href='/'>Назад</a>";
  page += "</div>";
  page += htmlFooter();

  server.send(200, "text/html", page);
}

void handleSave() {
  String p1 = server.arg("p1");
  String p2 = server.arg("p2");

  String page = htmlHeader("Результат");
  page += "<div class='container'>";

  if (p1 != p2) {
    page += "<p class='error'>Пароли не совпадают</p>";
  }
  else if (p1.length() < 4) {
    page += "<p class='error'>Пароль слишком короткий</p>";
  }
  else {
    prefs.putString("ap_pass", p1);
    page += "<p class='ok'>Пароль сохранён</p>";
    page += "<p>Точка доступа будет перезапущена</p>";
    rebootRequired = true;
  }

  page += "<a href='/'>На главную</a>";
  page += "</div>";
  page += htmlFooter();

  server.send(200, "text/html", page);
}

/* ---------- Wi-Fi ---------- */

void startAccessPoint() {
  WiFi.mode(WIFI_AP);

  if (apPassword.length() >= 4) {
    WiFi.softAP(AP_NAME, apPassword.c_str());
  } else {
    WiFi.softAP(AP_NAME);
  }

  Serial.println("AP started");
  Serial.println(WiFi.softAPIP());
}

/* ---------- Setup / Loop ---------- */

void setup() {
  Serial.begin(115200);

  prefs.begin("wifi", false);
  apPassword = prefs.getString("ap_pass", "");

  startAccessPoint();

  server.on("/", handleRoot);
  server.on("/config", handleConfig);
  server.on("/save", HTTP_POST, handleSave);

  server.begin();
}

void loop() {
  server.handleClient();

  if (rebootRequired) {
    delay(2000);
    ESP.restart();
  }
}
