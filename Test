/* ================= WIFI ================= */

void startAccessPoint() {
  WiFi.mode(WIFI_AP);

  if (apHasPassword) {
    WiFi.softAP(AP_SSID, apPassword.c_str());
  } else {
    WiFi.softAP(AP_SSID);
  }

  delay(200);
  dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());
}

/* ================= WEB ================= */

void setupWebServer() {

  server.on("/", []() {
    if (apHasPassword) {
      server.send(200, "text/html", PAGE_MAIN);
    } else {
      server.send(200, "text/html", PAGE_START);
    }
  });

  server.on("/nopass", []() {
    server.send(200, "text/html", PAGE_MAIN);
  });

  server.on("/setpass", []() {
    server.send(200, "text/html", PAGE_SET_PASS);
  });

  server.on("/savepass", HTTP_POST, []() {
    String p1 = server.arg("p1");
    String p2 = server.arg("p2");

    if (p1 != p2 || p1.length() < 8) {
      server.send(400, "text/plain", "Ошибка пароля");
      return;
    }

    prefs.begin("wifi", false);
    prefs.putString("ap_pass", p1);
    prefs.end();

    server.send(200, "text/html",
      "<h3>Пароль сохранён. Переподключитесь к сети.</h3>");

    delay(1000);
    ESP.restart();
  });

  server.onNotFound([]() {
    server.send(200, "text/html", PAGE_START);
  });

  server.begin();
}

/* ================= SETUP ================= */

void setup() {
  Serial.begin(115200);

  prefs.begin("wifi", true);
  apPassword = prefs.getString("ap_pass", "");
  prefs.end();

  apHasPassword = apPassword.length() >= 8;

  startAccessPoint();
  setupWebServer();
}

/* ================= LOOP ================= */

void loop() {
  dnsServer.processNextRequest();
  server.handleClient();
}
