#define DNS_PORT  53

/* ================= ОБЪЕКТЫ ================= */
WebServer server(80);
DNSServer dnsServer;
Preferences prefs;

/* ================= СОСТОЯНИЕ ================= */
bool apHasPassword = false;
String apPassword  = "";

