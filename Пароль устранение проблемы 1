#include <WiFi.h>
#include <WebServer.h>
#include <DNSServer.h>
#include <Preferences.h>

// ===== НАСТРОЙКИ =====
#define AP_SSID "Система управления"
#define DNS_PORT 53

WebServer server(80);
DNSServer dnsServer;
Preferences prefs;

// ===== СОСТОЯНИЕ =====
bool needRestartAP = false;
unsigned long restartAt = 0;

// ===== ПРОТОТИПЫ =====
void startAccessPoint();
void restartAccessPoint();
String loadPassword();
void savePassword(const String& pwd);

