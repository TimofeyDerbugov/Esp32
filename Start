/* ===== AP ===== */

void startAP() {
  WiFi.mode(WIFI_AP);
  if (apHasPassword) {
    WiFi.softAP(AP_SSID, apPassword.c_str());
  } else {
    WiFi.softAP(AP_SSID);
  }
  delay(200);
  dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());
}

/* ===== WEB ===== */

void setupWeb() {

  webServer.on("/", [](){
    if (!apHasPassword) {
      webServer.send(200,"text/html",PAGE_WIFI_SETUP);
    } else {
      webServer.send(200,"text/html",PAGE_MAIN);
    }
  });

  webServer.on("/nopass", [](){
    webServer.send(200,"text/html",PAGE_MAIN);
  });

  webServer.on("/setpass", [](){
    webServer.send(200,"text/html",PAGE_SET_PASSWORD);
  });

  webServer.on("/savepass", HTTP_POST, [](){
    String p1 = webServer.arg("p1");
    String p2 = webServer.arg("p2");

    if (p1 != p2 || p1.length() < 8) {
      webServer.send(400,"text/plain","Пароли не совпадают или слишком короткие");
      return;
    }

    prefs.begin("wifi", false);
    prefs.putString("ap_pass", p1);
    prefs.end();

    apPassword = p1;
    apHasPassword = true;

    webServer.send(200,"text/html","<h3>Пароль сохранён. Переподключитесь к сети.</h3>");

    delay(1000);
    ESP.restart();
  });

  webServer.onNotFound([](){
    webServer.send(200,"text/html",PAGE_WIFI_SETUP);
  });

  webServer.begin();
}

/* ===== SETUP ===== */

void setup() {
  Serial.begin(115200);

  prefs.begin("wifi", true);
  apPassword = prefs.getString("ap_pass", "");
  prefs.end();

  apHasPassword = apPassword.length() >= 8;

  startAP();
  setupWeb();
}

/* ===== LOOP ===== */

void loop() {
  dnsServer.processNextRequest();
  webServer.handleClient();
}
